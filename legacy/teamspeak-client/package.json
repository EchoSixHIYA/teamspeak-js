{
  "name": "@honeybbq/teamspeak-client",
  "version": "1.0.0-beta.4",
  "description": "Renamed to @honeybbq/teamspeak; this package re-exports it and its /client entry so existing imports keep working",
  "keywords": [
    "client",
    "sdk",
    "teamspeak",
    "ts3",
    "ts6",
    "voip"
  ],
  "homepage": "https://github.com/HoneyBBQ/teamspeak-js/tree/main/legacy/teamspeak-client#readme",
  "bugs": {
    "url": "https://github.com/HoneyBBQ/teamspeak-js/issues"
  },
  "license": "MIT",
  "author": "honeybbq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoneyBBQ/teamspeak-js.git",
    "directory": "legacy/teamspeak-client"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@honeybbq/teamspeak": "workspace:*"
  },
  "engines": {
    "node": ">=22.12"
  }
}
