{
  "$schema": "https://typedoc.org/schema.json",
  // One module per entry point users import: `@honeybbq/teamspeak` (the core)
  // and `@honeybbq/teamspeak/client`, each named by an `@module` tag in its
  // entry file. The client's declarations refer to the core through the
  // package's own name, which resolves to the sources, so {@link}s between
  // the two entries work and no build is needed before running typedoc.
  "name": "teamspeak-js",
  "entryPoints": ["src/core/index.ts", "src/client/index.ts"],
  "tsconfig": "tsconfig.typedoc.json",
  "readme": "README.md",
  "projectDocuments": ["docs/migrating-to-1.0.md", "docs/voice-protocol-responses.md"],
  "out": "dist/docs",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeNotDocumented": false,
  "githubPages": true,
  // Each enumeration is `typeof xValues`, a helper const that is private to its
  // file; its members are documented on the exported const of the same
  // shape (Codec, ErrorCode, ClientStatus, ConnectPhase, ...). The
  // `__object.*` entries are the members of those helpers that other types
  // refer to, as KickReason does to Reason.KickChannel.
  "intentionallyNotExported": [
    "clientStatusValues",
    "connectPhaseValues",
    "clientTypeValues",
    "codecValues",
    "commandNameValues",
    "errorCodeValues",
    "groupNameModeValues",
    "groupTypeValues",
    "logLevelValues",
    "notificationNameValues",
    "permissionNameValues",
    "permissionTargetValues",
    "privilegeKeyTypeValues",
    "propertyNameValues",
    "reasonValues",
    "textMessageTargetValues",
    "__object.Channel",
    "__object.ChannelClient",
    "__object.ChannelGroup",
    "__object.Client",
    "__object.KickChannel",
    "__object.KickServer",
    "__object.ServerGroup"
  ],
  "treatWarningsAsErrors": true
}
