{
  "name": "teamspeak-js",
  "private": true,
  "description": "TeamSpeak SDKs for TypeScript: a clean-room voice client, and the core it shares with ServerQuery",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HoneyBBQ/teamspeak-js"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check",
    "test:integration": "vitest run packages/client/src/integration.test.ts --reporter=verbose",
    "test:integration:ts3": "TEAMSPEAK_ADDR=127.0.0.1:9987 TEAMSPEAK_DEFAULT_CHANNEL=Alpha TEAMSPEAK_PASSWORD_CHANNEL=Secret TEAMSPEAK_PASSWORD_CHANNEL_PASSWORD=hunter2 pnpm test:integration",
    "test:integration:ts6": "TEAMSPEAK_ADDR=127.0.0.1:9988 TEAMSPEAK_DEFAULT_CHANNEL=Alpha TEAMSPEAK_PASSWORD_CHANNEL=Secret TEAMSPEAK_PASSWORD_CHANNEL_PASSWORD=hunter2 pnpm test:integration",
    "test:integration:both": "pnpm test:integration:ts3 && pnpm test:integration:ts6",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.59.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.8",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.32.1"
}
