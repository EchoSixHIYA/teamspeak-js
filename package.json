{
  "name": "teamspeak-js",
  "private": true,
  "description": "TeamSpeak SDK for TypeScript: a clean-room voice client, and the typed commands, ids and errors every connection shares",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HoneyBBQ/teamspeak-js"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check",
    "test:integration": "vitest run packages/teamspeak/src/client/integration.test.ts --reporter=verbose",
    "test:integration:ts3": "TEAMSPEAK_ADDR=127.0.0.1:9987 TEAMSPEAK_DEFAULT_CHANNEL=Alpha TEAMSPEAK_PASSWORD_CHANNEL=Secret TEAMSPEAK_PASSWORD_CHANNEL_PASSWORD=hunter2 pnpm test:integration",
    "test:integration:ts6": "TEAMSPEAK_ADDR=127.0.0.1:9988 TEAMSPEAK_DEFAULT_CHANNEL=Alpha TEAMSPEAK_PASSWORD_CHANNEL=Secret TEAMSPEAK_PASSWORD_CHANNEL_PASSWORD=hunter2 pnpm test:integration",
    "test:integration:both": "pnpm test:integration:ts3 && pnpm test:integration:ts6",
    "changeset": "changeset",
    "version-packages": "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} changeset version && pnpm install --lockfile-only",
    "check:docs": "node scripts/check-docs.mts",
    "api:report": "pnpm build && api-extractor run --local -c packages/teamspeak/api-extractor.core.json && api-extractor run --local -c packages/teamspeak/api-extractor.client.json",
    "api:check": "pnpm build && node scripts/api-check.mts",
    "docs:build": "typedoc"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@honeybbq/teamspeak": "workspace:*",
    "@microsoft/api-extractor": "7.59.4",
    "@types/node": "^26.1.1",
    "fast-check": "^4.10.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.59.0",
    "oxlint-tsgolint": "^7.0.2004",
    "publint": "^0.3.25",
    "tsx": "^4.21.0",
    "typedoc": "0.28.20",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@^5.9.3",
    "vite": "^8.0.8",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.32.1"
}
