{
  "extends": "../../api-extractor.base.json",
  "mainEntryPointFilePath": "<projectFolder>/dist/client/index.d.ts",
  "apiReport": { "reportFileName": "client.api.md" },
  "compiler": {
    "overrideTsconfig": {
      "extends": "../../tsconfig.base.json",
      "compilerOptions": {
        // Through node_modules, so that api-extractor treats the core's types
        // as external and writes `import { X } from '@honeybbq/teamspeak'`
        // instead of reporting each one as a forgotten export.
        "paths": {
          "@honeybbq/teamspeak": ["../../node_modules/@honeybbq/teamspeak/dist/core/index.d.ts"]
        }
      },
      "files": ["./dist/client/index.d.ts"]
    }
  }
}
