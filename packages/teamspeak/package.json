{
  "name": "@honeybbq/teamspeak",
  "version": "1.0.0-beta.4",
  "description": "TeamSpeak SDK for TypeScript: a clean-room voice client for Node.js, and the typed commands, ids and errors every connection shares",
  "keywords": [
    "client",
    "sdk",
    "teamspeak",
    "ts3",
    "ts6",
    "voip"
  ],
  "homepage": "https://github.com/HoneyBBQ/teamspeak-js/tree/main/packages/teamspeak#readme",
  "bugs": {
    "url": "https://github.com/HoneyBBQ/teamspeak-js/issues"
  },
  "license": "MIT",
  "author": "honeybbq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoneyBBQ/teamspeak-js.git",
    "directory": "packages/teamspeak"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/client/testing",
    "!src/query",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/core/index.ts",
    "./client": "./src/client/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "types": "./dist/core/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/connect.ts",
    "prepack": "cp ../../README.md README.md",
    "postpack": "rm -f README.md"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
