{
  "name": "@honeybbq/teamspeak-serverquery",
  "version": "0.3.1",
  "private": true,
  "description": "A TeamSpeak ServerQuery client, over raw TCP, SSH or the HTTP WebQuery",
  "keywords": [
    "sdk",
    "serverquery",
    "teamspeak",
    "ts3",
    "ts6"
  ],
  "license": "MIT",
  "author": "honeybbq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoneyBBQ/teamspeak-js.git",
    "directory": "packages/serverquery"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@honeybbq/teamspeak-core": "workspace:*"
  },
  "engines": {
    "node": ">=20.19"
  }
}
